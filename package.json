{
  "name": "dlsauto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev",
    "devsafe": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:design": "tsx scripts/design-audit.ts",
    "tokens": "tsx scripts/export-tokens.ts",
    "tokens:check": "tsx scripts/export-tokens.ts --check",
    "check:literals": "node scripts/check-no-literals.mjs",
    "design:compare": "node scripts/design-compare.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "import:prom": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-prom.ts",
    "worker": "cross-env NODE_OPTIONS=--no-deprecation tsx src/worker/index.ts",
    "worker:dev": "cross-env NODE_OPTIONS=--no-deprecation tsx watch src/worker/index.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "10.1.0",
    "fast-xml-parser": "^5.11.2",
    "graphql": "16.14.2",
    "next": "16.4.3",
    "payload": "3.92.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
