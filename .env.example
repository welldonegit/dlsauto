# DLSAuto — environment variables.
# Copy to `.env` for local development. Never commit real secrets.
# On the server, values are set through Dokploy env (not this file).

# ----------------------------------------------------------------------------
# Site
# ----------------------------------------------------------------------------
NODE_ENV=development
# Single source of truth for the public domain. Used by deploy configs AND by
# the app (metadataBase, canonical, hreflang, sitemap, CSP). Leave empty locally.
# Stage uses stage.<DOMAIN>, prod uses <DOMAIN>.
DOMAIN=
# Local fallback origin when DOMAIN is empty (dev only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Build identifier shown on the homepage and /api/health. Injected by CI/Docker.
NEXT_PUBLIC_BUILD_SHA=dev

# ----------------------------------------------------------------------------
# Database (PostgreSQL 16, extensions pg_trgm + unaccent)
# ----------------------------------------------------------------------------
DATABASE_URL=postgres://dlsauto:dlsauto@localhost:5432/dlsauto
# Used only by the local docker-compose Postgres service.
POSTGRES_USER=dlsauto
POSTGRES_PASSWORD=dlsauto
POSTGRES_DB=dlsauto
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# Payload CMS
# ----------------------------------------------------------------------------
# Long random string. Generate: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-in-local-and-use-a-real-secret-on-server
# First admin, created automatically on an empty database at first boot.
PAYLOAD_ADMIN_EMAIL=admin@example.com
PAYLOAD_ADMIN_PASSWORD=change-me

# ----------------------------------------------------------------------------
# Worker
# ----------------------------------------------------------------------------
WORKER_PORT=3001

# ----------------------------------------------------------------------------
# Backups (deploy/backup.sh — server only)
# ----------------------------------------------------------------------------
# rclone remote name configured for Cloudflare R2 (e.g. `r2`).
RCLONE_REMOTE=r2
R2_BUCKET=dlsauto-backups
BACKUP_RETENTION_DAYS=30
# Absolute path to uploaded media on the server.
MEDIA_DIR=/data/media
# Telegram alert on backup failure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------------------
# Integrations — placeholders, wired in stages 5–6. Keep empty for now.
# ----------------------------------------------------------------------------
# KeyCRM (stock & orders master) — stage 6
KEYCRM_API_URL=
KEYCRM_API_TOKEN=
KEYCRM_WEBHOOK_SECRET=
# Prom.ua — stage 6
PROM_API_TOKEN=
# Nova Poshta — stage 5
NOVAPOSHTA_API_KEY=
# Delivery — stage 5
DELIVERY_API_KEY=
# monoPay — stage 5
MONOPAY_TOKEN=
MONOPAY_WEBHOOK_PUBKEY=
# Email provider (Resend or SMTP) — decided in stage 5
EMAIL_FROM=
RESEND_API_KEY=
# Sentry (optional) — monitoring
SENTRY_DSN=
